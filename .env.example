# Chaupal Seal — root (Foundry) environment template.
# Copy to `.env` (gitignored) and fill in local values. Only this file is tracked.

# Signing key for forge create / cast send / forge script (e.g. anvil account 0
# for local deploys). Never commit a real value.
PRIVATE_KEY=your_private_key_here
NEXT_PUBLIC_CHAIN_ID=
# JSON-RPC endpoint (defaults to local anvil)
RPC_URL=http://127.0.0.1:8545