# Chaupal Seal UI — environment template.
# Copy to `.env.local` (gitignored) and fill in local values. Only this file is tracked.

# Address of the deployed ChaupalSeal contract (0x + 40 hex)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain id the contract is deployed on
NEXT_PUBLIC_CHAIN_ID=31337

# RPC endpoint for contract reads/writes
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545